From: oplus-sukisu_kernel maintainers
Subject: [PATCH] KernelSU: guard priority_uid_filter calls behind CMD_SUSFS_SET_PRIORITY_UID_FILTER

susfs_parse_priority_app_strings() and the CMD_SUSFS_SET_PRIORITY_UID_FILTER
supercall only exist in susfs4ksu commits rebased onto android16-6.12.92.
Those commits' 50_add_susfs patch rejects on our 6.12.69 base, so we build
against an older SUSFS that lacks the command while SukiSU-Ultra's builtin
tree still references it.

Guard the call sites so the tree compiles either way.

Local compatibility shim, not an upstream patch.

--- a/kernel/supercall/dispatch.c
+++ b/kernel/supercall/dispatch.c
@@ -475,8 +475,10 @@
             return 0;
 #endif // #ifdef CONFIG_KSU_SUSFS_SUS_MAP
+#ifdef CMD_SUSFS_SET_PRIORITY_UID_FILTER
         case CMD_SUSFS_SET_PRIORITY_UID_FILTER:
             susfs_set_priority_uid_filter(arg);
             return 0;
+#endif
         case CMD_SUSFS_ENABLE_AVC_LOG_SPOOFING:
             susfs_set_avc_log_spoofing(arg);
             return 0;
--- a/kernel/manager/pkg_observer.c
+++ b/kernel/manager/pkg_observer.c
@@ -22,4 +22,6 @@
     track_throne(false);
     // Renew the priority uid bitmap filter
+#ifdef CMD_SUSFS_SET_PRIORITY_UID_FILTER
     susfs_parse_priority_app_strings();
+#endif
 }
@@ -36,3 +38,5 @@
     // Renew the getpriority uid bitmap filter
+#ifdef CMD_SUSFS_SET_PRIORITY_UID_FILTER
     susfs_parse_priority_app_strings();
+#endif
 
