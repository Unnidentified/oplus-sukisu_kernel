From: oplus-sukisu_kernel maintainers
Subject: [PATCH] KernelSU: pass struct lsm_id to security_add_hooks() on 6.7+

SukiSU-Ultra's builtin branch still calls
security_add_hooks(hooks, count, "ksu"). Kernels >= 6.7 take a
const struct lsm_id * instead, so the builtin tree does not compile on
android16-6.12 without this.

Local compatibility shim, not an upstream patch. Applied only when it
applies cleanly, so it is a no-op on older trees.

--- a/kernel/hook/lsm_hook.c
+++ b/kernel/hook/lsm_hook.c
@@ -186,10 +186,21 @@ static struct security_hook_list ksu_hooks[] = {
     LSM_HOOK_INIT(file_permission, ksu_mount_hide_file_permission),
 };
 
+#if LINUX_VERSION_CODE >= KERNEL_VERSION(6, 7, 0)
+static struct lsm_id ksu_lsm_id = {
+    .name = "ksu",
+    .id = 0x6b7375,
+};
+#endif
+
 void __init ksu_lsm_hook_init(void)
 {
 #if LINUX_VERSION_CODE >= KERNEL_VERSION(4, 11, 0)
-    security_add_hooks(ksu_hooks, ARRAY_SIZE(ksu_hooks), "ksu");
+#if LINUX_VERSION_CODE >= KERNEL_VERSION(6, 7, 0)
+    security_add_hooks(ksu_hooks, ARRAY_SIZE(ksu_hooks), &ksu_lsm_id);
+#else
+    security_add_hooks(ksu_hooks, ARRAY_SIZE(ksu_hooks), "ksu");
+#endif
 #else
     // https://elixir.bootlin.com/linux/v4.10.17/source/include/linux/lsm_hooks.h#L1892
     security_add_hooks(ksu_hooks, ARRAY_SIZE(ksu_hooks));
